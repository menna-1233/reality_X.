# Supabase project (see: https://ccvdyifhquvcdixaqpat.supabase.co)
SUPABASE_URL=https://ccvdyifhquvcdixaqpat.supabase.co
# Service role key — grab it from Supabase dashboard > Project Settings > API.
# Needed server-side so the backend can write reports/incidents regardless of RLS.
# NEVER expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=e0d54643-b957-4057-a814-e909bdb5cf88
VITE_API_BASE_URL=http://localhost:8000

# Default community used for the hackathon demo (seeded in migrations).
DEFAULT_COMMUNITY_ID=

# Threshold of independent reports on the same incident before we notify residents.
NOTIFY_REPORT_COUNT_THRESHOLD=3

# AI classifier backend: "mock" (keyword heuristic, no setup needed) or
# "ollama" (real open-source vision+language model running locally, free).
# See backend/README.md for setup instructions.
AI_BACKEND=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl
OLLAMA_TIMEOUT_SECONDS=60
