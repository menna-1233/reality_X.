# Supabase project (see: https://ccvdyifhquvcdixaqpat.supabase.co)
SUPABASE_URL=https://ccvdyifhquvcdixaqpat.supabase.co
# Service role key — grab it from Supabase dashboard > Project Settings > API.
# Needed server-side so the backend can write reports/incidents regardless of RLS.
# NEVER expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Default community used for the hackathon demo (seeded in migrations).
DEFAULT_COMMUNITY_ID=e0d54643-b957-4057-a814-e909bdb5cf88

# Threshold of independent reports on the same incident before we notify residents.
NOTIFY_REPORT_COUNT_THRESHOLD=3

# AI classifier backend: "mock" (keyword heuristic, no setup needed) or
# "ollama" (real open-source vision+language model running locally, free).
# See backend/README.md for setup instructions.
# AI classifier backend:
#   "mock"   — keyword heuristic, no setup needed (default)
#   "ollama" — local open-source model, needs Ollama running on this machine
#   "groq"   — free cloud inference, needs GROQ_API_KEY (get one free at console.groq.com)
AI_BACKEND=mock

# Ollama settings (only used when AI_BACKEND=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT_SECONDS=60

# Groq settings (only used when AI_BACKEND=groq)
# Free API key: https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Department email notifications — sent automatically when a report is
# created, routed to the department responsible for that problem type.
# Setup (Gmail): enable 2-Step Verification, then create an App Password
# at https://myaccount.google.com/apppasswords (NOT your regular password).
SMTP_ENABLED=false
SMTP_EMAIL=
SMTP_APP_PASSWORD=
# Optional: override which email each problem type notifies (JSON).
# Defaults to test/placeholder addresses in app/email_service.py.
# DEPARTMENT_EMAILS={"pothole": "roads@city.gov", "garbage": "clean@city.gov"}
DEPARTMENT_EMAILS=
