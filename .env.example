# Base URL of the RealityX backend.
# In production the app falls back to the deployed Supabase Edge Function
# (see supabase/functions/urbaneye-api) if this isn't set. Point it at
# http://localhost:8000 for local development against backend/ (FastAPI).
VITE_API_BASE_URL=http://localhost:8000

